+      xc.db.prepare("UPDATE xc_history SET retry_s=? WHERE owner=?").run(now+3600,job.owner);
+      return;
+    }
+    history.enroll(job.owner,session.garmin_permissions,Boolean(settings.cycle),now);
+    await history.step(job,now,async (feed,start,end) => {
+      const token = await validGarminToken(session);
+      if (accountSession(job.owner,"garmin") !== session || session.status !== "connected" ||
+          !xc.settings(job.owner,session.account.user_id) ||
+          !history.status(job.owner).some(row => row.feed === feed && row.first_s === job.first_s)) {
+        throw new Error("Garmin access changed");
+      }
+      return requestHistory(token,feed,start,end);
+    });
+  } catch {
+    // Network failures keep the same interval for the next worker pass.
+    console.error("xc Garmin history awaiting retry");
+  } finally { historyBusy = false; }
+}
