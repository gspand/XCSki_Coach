+test("large FIT pages survive replay, retain oversized first record and isolate owners", () => {
+  const inbox = new XcGarminInbox(":memory:",Buffer.alloc(32));
+  try {
+    inbox.enroll("one","source",false);
+    for (let id=1;id<=3;id++) inbox.put("one","source","activity","activityFiles",{activityId:id,samples:"x".repeat(820000)});
+    for(let id=1;id<=3;id++){
+      const page=inbox.page("one");
+      assert.equal(page.length,1);
+      assert.equal(page[0].data.activityId,id);
+      assert.deepEqual(inbox.page("one").map(r=>r.receipt),[page[0].receipt]);
+      assert.deepEqual(inbox.page("two"),[]);
+      inbox.ack("one",[page[0].receipt]);
+    }
+  } finally { inbox.db.close(); }
+});
